            <figure class="relative group overflow-hidden bg-[#023047]/20 rounded-lg h-52">
              <img src="/images/outreach/nit-recerca-1.jpeg" alt="Nit de la Recerca, Barcelona, 2022" class="w-full h-full object-cover rounded-lg transition-transform duration-300 group-hover:scale-[1.02]" loading="lazy" />
