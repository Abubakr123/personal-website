    <section class="bg-[#023047]/80 backdrop-blur-md p-8 rounded-2xl border border-[#8ecae6]/20">
      <h2 class="text-3xl md:text-4xl font-bold mb-6 text-[#FFFFFF]">Outreach in Photos</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          outreachImages.map((image) => (
            <div class="relative group overflow-hidden bg-[#023047]/20 rounded-lg h-64">
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                class={`w-full h-full rounded-lg transition-transform duration-300 group-hover:scale-[1.02] ${image.imgClass ?? "object-cover"}`}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#023047]/80 via-[#023047]/50 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300 rounded-lg flex items-end">
                <p class="text-[#FFFFFF] p-4 text-sm md:text-base font-medium backdrop-blur-sm bg-[#023047]/30 w-full rounded-b-lg">{image.caption}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <div class="text-center pt-2">
      <a href="/contact" class="inline-flex items-center gap-2 bg-space-orange text-white px-8 py-3 rounded-full font-semibold hover:bg-space-orange-light transition-colors duration-200">
        Want to collaborate on an outreach activity? → Get in Touch
      </a>
    </div>
  </div>
</section>

<script>
  // Load TikTok embed script only after the page is idle so initial paint stays fast.
  if (typeof window !== "undefined") {
    const loadTikTok = () => {
      const s = document.createElement("script");
      s.async = true;
      s.src = "https://www.tiktok.com/embed.js";
      document.body.appendChild(s);
    };
    if ("requestIdleCallback" in window) {
      requestIdleCallback(loadTikTok, { timeout: 3000 });
    } else {
      setTimeout(loadTikTok, 1500);
    }
  }
</script>