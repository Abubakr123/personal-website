            src="/images/outreach/magnet-sahrawi-kids.webp"
            alt="Astronomy session with Sahrawi children, Castelldefels, 2023"
            class="w-full h-full object-cover rounded-lg transition-transform duration-300 group-hover:scale-[1.02]"
