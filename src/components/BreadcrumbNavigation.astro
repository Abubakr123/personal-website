---
// Get current URL path
const path = Astro.url.pathname;
const segments = path.split('/').filter(Boolean);

// Create breadcrumb items
const breadcrumbs = [
  { href: '/', text: 'Home' },
  ...segments.map((segment, i) => {
    const href = `/${segments.slice(0, i + 1).join('/')}`;
    return {
      href,
      text: segment.charAt(0).toUpperCase() + segment.slice(1),
    };
  }),
];
---

<nav aria-label="Breadcrumb" class="py-3 px-4 max-w-7xl mx-auto">
  <ol class="flex flex-wrap items-center space-x-2 text-sm">
    {
      breadcrumbs.map((crumb, i) => (
        <>
          {i > 0 && (
            <li class="text-space-blue-light/50">
              <span>/</span>
            </li>
          )}
          <li>
            {i === breadcrumbs.length - 1 ? (
              <span class="text-space-orange font-medium">{crumb.text}</span>
            ) : (
              <a 
                href={crumb.href}
                class="text-gray-300 hover:text-space-blue-light transition-colors"
              >
                {crumb.text}
              </a>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
