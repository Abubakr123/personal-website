---
// Get current path to highlight active link
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", text: "Home" },
  { href: "/about", text: "About" },
  { href: "/research", text: "Research" },
  { href: "/publications", text: "Publications" },
  { href: "/cv", text: "CV" },
  { href: "/talks", text: "Talks" },
  { href: "/outreach", text: "Outreach" },
  { href: "/blog", text: "Blog" },
  { href: "/contact", text: "Contact" }
];
---

<nav 
  x-data="{ mobileMenuOpen: false }" 
  class="fixed top-0 w-full bg-space-blue-dark/80 backdrop-blur-md z-50 border-b border-space-blue-light/10 transition-all duration-300"
  :class="{ 'shadow-md': window.scrollY > 0 }"
  @scroll.window="navShadow = (window.scrollY > 0)"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="text-white font-bold text-xl hover:text-space-blue-light transition-colors flex items-center">
          <span class="mr-1">Abubakr Ibrahim</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:block">
        <div class="flex items-baseline space-x-4">
          {
            navItems.map(({ href, text }) => {
              // Check if this link is active
              const isActive = 
                href === "/" 
                  ? currentPath === "/" 
                  : currentPath.startsWith(href);
                  
              return (
                <a
                  href={href}
                  class={`px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 ${
                    isActive 
                      ? "text-space-orange" 
                      : "text-gray-300 hover:text-space-blue-light"
                  }`}
                >
                  {text}
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button 
          @click="mobileMenuOpen = !mobileMenuOpen" 
          type="button" 
          class="text-gray-400 hover:text-white p-2" 
          aria-controls="mobile-menu" 
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <!-- Icon when menu is closed -->
          <svg 
            x-show="!mobileMenuOpen"
            class="h-6 w-6" 
            xmlns="http://www.w3.org/2000/svg" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor" 
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Icon when menu is open -->
          <svg 
            x-show="mobileMenuOpen"
            class="h-6 w-6" 
            xmlns="http://www.w3.org/2000/svg" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor" 
            aria-hidden="true"
            style="display: none;"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div 
    x-show="mobileMenuOpen" 
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="transform opacity-0 scale-95"
    x-transition:enter-end="transform opacity-100 scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="transform opacity-100 scale-100"
    x-transition:leave-end="transform opacity-0 scale-95"
    class="md:hidden bg-space-blue-dark/95 backdrop-blur-md"
    style="display: none;"
  >
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 border-t border-space-blue-light/10">
      {
        navItems.map(({ href, text }) => {
          const isActive = 
            href === "/" 
              ? currentPath === "/" 
              : currentPath.startsWith(href);
              
          return (
            <a
              href={href}
              @click="mobileMenuOpen = false"
              class={`block px-3 py-2 rounded-md text-base font-medium ${
                isActive 
                  ? "text-space-orange bg-space-blue-dark/50" 
                  : "text-gray-300 hover:bg-space-blue-light/10 hover:text-white"
              }`}
            >
              {text}
            </a>
          );
        })
      }
    </div>
  </div>
</nav>

<script>
  // Add smooth scroll behavior
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        
        const targetId = this.getAttribute('href').substring(1);
        const targetElement = document.getElementById(targetId);
        
        if (targetElement) {
          window.scrollTo({
            top: targetElement.offsetTop - 80,
            behavior: 'smooth'
          });
        }
      });
    });
  });
</script>